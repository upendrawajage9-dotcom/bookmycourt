# =============================================================
# BookMyCourt — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME=BookMyCourt
APP_ENV=development        # development | production
APP_DEBUG=true             # Set to false in production
APP_URL=http://localhost/BookMyCourt

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=badminton_booking
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ─── Payment Gateway (Razorpay) ──────────────────────────────
# Sign up at https://razorpay.com and get test keys from Dashboard → API Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET
RAZORPAY_CURRENCY=INR
RAZORPAY_MODE=test         # test | live

# ─── Session ─────────────────────────────────────────────────
SESSION_LIFETIME=7200      # 2 hours in seconds

# ─── Security ────────────────────────────────────────────────
CSRF_SECRET=change_this_to_a_random_32_char_string
